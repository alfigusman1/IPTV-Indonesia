NODE_ENV=production
PORT=4300

# ─── MySQL (database iptv @ 192.168.18.142) ─────────────────────────────────
DB_HOST=192.168.18.142
DB_PORT=3306
DB_USER=iptv
DB_PASS=ganti-dengan-password-iptv
DB_NAME=iptv

# ─── Health-checker ─────────────────────────────────────────────────────────
# Timeout per channel (ms), konkurensi cek paralel, ambang fail sebelum 'dead'.
CHECK_TIMEOUT_MS=8000
CHECK_CONCURRENCY=20
CHECK_FAIL_THRESHOLD=2
# Cron cek berkala (default tiap 30 menit) & import berkala (default tiap 6 jam).
CHECK_CRON=*/30 * * * *
IMPORT_CRON=0 */6 * * *
# Jalankan import + check sekali ~30 detik setelah start (catch-up).
RUN_ON_START=true

# ─── CORS (bila frontend di-host terpisah; kosong = sama-origin saja) ────────
CORS_ORIGINS=
